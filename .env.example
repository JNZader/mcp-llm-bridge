# LLM Gateway Configuration
# Copy this file to .env and adjust values as needed.

# Master encryption key for the credential vault.
# Must be a 64-character hex string (32 bytes).
# If not set, a key is auto-generated and stored at ~/.llm-gateway/master.key
# LLM_GATEWAY_MASTER_KEY=

# Path to the SQLite credential vault database.
# Default: ~/.llm-gateway/vault.db
# LLM_GATEWAY_DB_PATH=~/.llm-gateway/vault.db

# HTTP server port for the gateway API.
# Default: 3456
# LLM_GATEWAY_PORT=3456

# Bearer token for HTTP API authentication.
# Must be at least 32 characters. If not set, auth is disabled (local dev).
# In production (NODE_ENV=production), this is required.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LLM_GATEWAY_AUTH_TOKEN=

# CORS allowed origins (comma-separated list).
# If not set, defaults to allowing only GitHub Pages dashboard.
# Use '*' to allow all origins (not recommended for production).
# Example: 'https://example.com,https://app.example.com'
# LLM_GATEWAY_CORS_ORIGINS=

# Environment indicator for production mode.
# If set to 'production', auth is required and startup fails without LLM_GATEWAY_AUTH_TOKEN.
# NODE_ENV=production

# ── GitHub OAuth (optional) ──────────────────────────────
# Enables "Login with GitHub" in the dashboard.
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: https://your-domain.com/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Secret for signing dashboard session JWTs (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when GITHUB_CLIENT_ID is set.
# GITHUB_OAUTH_SECRET=

# Comma-separated GitHub usernames allowed to access the dashboard.
# If not set, any authenticated GitHub user can access.
# GITHUB_ALLOWED_USERS=yourusername,colleague

# ── Security Profile (Sprint 1) ──────────────────────────
# Trust level for tool and endpoint filtering.
# Options: local-dev (all tools, no rate limit), restricted (read+generate only),
#          open (generate only, 10 req / 15 min)
# Default: local-dev
# LLM_GATEWAY_SECURITY_PROFILE=local-dev

# ── Approval Flows (Sprint 1) ────────────────────────────
# Enable approval gating for destructive MCP tools under non-local-dev profiles.
# Default: true
# APPROVAL_FLOWS_ENABLED=true

# ── Three-Part Prompt Optimization (Sprint 2) ────────────
# Enable automatic splitting of flat prompts into system/context/instruction.
# Default: true
# OPTIMIZE_MESSAGES_ENABLED=true

# ── RTK Output Compression (Sprint 2) ─────────────────────
# Strip redundant fields, group arrays, and truncate long values in tool results.
# Default: true
# ENABLE_OUTPUT_COMPRESSION=true

# ── Local LLM Offloading (Sprint 3) ──────────────────────
# Route offloadable tasks (summarization, formatting, etc.) to Ollama/LM Studio.
# Default: false
# LOCAL_LLM_ENABLED=false
# OLLAMA_URL=http://localhost:11434
# LM_STUDIO_URL=http://localhost:1234

# ── HF Auto-Discovery (Sprint 3) ───────────────────────
# Scan local backends and enrich models with HuggingFace metadata at startup.
# Requires LOCAL_LLM_ENABLED=true and optionally HF_TOKEN for private repos.
# Default: false
# AUTO_DISCOVER_MODELS=false
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Model Routing ──────────────────────────────────────
# Enable task-aware model selection based on cost tiers, quality thresholds,
# and routing rules defined in model-routing.json.
# When enabled, the router classifies each prompt and picks the optimal endpoint.
# Default: false
MODEL_ROUTING_ENABLED=false

# ── Dynamic MCP Servers (mcp-builder) ───────────────────
# Load external .mcp-server.js plugin files at runtime.
# Default: false
MCP_DYNAMIC_SERVERS=false
MCP_SERVERS_DIR=./mcp-servers

# ── Hybrid Search Configuration ─────────────────────────
# Embedding provider and model settings for semantic code search.
# Default: local embedder (Xenova/all-MiniLM-L6-v2, 22MB, 384-dim).
# Fallback API embedder requires OPENAI_API_KEY or VOYAGE_API_KEY.
# EMBEDDER_MODE=local            # local (default) | api
# OPENAI_API_KEY=sk-...          # Fallback API embedder (optional)
# VOYAGE_API_KEY=...             # Alternative API embedder (optional)
# TRANSFORMERS_OFFLINE=1         # Use cached model only, no download
