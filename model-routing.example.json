{
  "_comment": "Example model-routing.json. Copy to model-routing.json in the project root and customize. See README.md #model-routing for full documentation.",
  "enabled": true,
  "endpoints": [
    {
      "_comment": "Premium coding endpoint — high quality, standard cost",
      "id": "anthropic-claude-sonnet",
      "providerId": "anthropic",
      "model": "claude-sonnet-4-20250514",
      "costTier": "standard",
      "capabilities": ["chat", "completion", "code", "analysis", "reasoning"],
      "maxTokens": 128000
    },
    {
      "_comment": "Top-tier reasoning endpoint — most capable, most expensive",
      "id": "openai-gpt-4o",
      "providerId": "openai",
      "model": "gpt-4o",
      "costTier": "expensive",
      "capabilities": ["chat", "completion", "code", "analysis", "reasoning", "vision"],
      "maxTokens": 128000
    },
    {
      "_comment": "Fast and cheap endpoint for chat and simple tasks",
      "id": "groq-llama-70b",
      "providerId": "groq",
      "model": "llama-3.3-70b-versatile",
      "costTier": "cheap",
      "capabilities": ["chat", "completion", "code"],
      "maxTokens": 8192
    },
    {
      "_comment": "Free CLI-backed endpoint via OpenCode subscription",
      "id": "opencode-cli-default",
      "providerId": "opencode-cli",
      "model": "opencode-cli",
      "costTier": "free",
      "capabilities": ["chat", "completion", "code"],
      "maxTokens": 8192
    },
    {
      "_comment": "Local Ollama endpoint — zero token cost, requires LOCAL_LLM_ENABLED=true",
      "id": "local-llm-ollama",
      "providerId": "local-llm",
      "model": "llama3.1:8b",
      "costTier": "free",
      "capabilities": ["chat", "completion"],
      "maxTokens": 4096
    }
  ],
  "rules": [
    {
      "_comment": "Code review tasks get the strongest review-oriented models first",
      "id": "rule-code-review",
      "taskType": "code-review",
      "preferredEndpoints": ["anthropic-claude-sonnet", "openai-gpt-4o"],
      "maxCostTier": "expensive",
      "allowFallback": true
    },
    {
      "_comment": "Large-context work prefers the biggest context windows",
      "id": "rule-large-context",
      "taskType": "large-context",
      "preferredEndpoints": ["openai-gpt-4o", "anthropic-claude-sonnet"],
      "maxCostTier": "expensive",
      "allowFallback": true
    },
    {
      "_comment": "Short generic prompts can use fast/cheap models first",
      "id": "rule-fast-completion",
      "taskType": "fast-completion",
      "preferredEndpoints": ["groq-llama-70b", "opencode-cli-default"],
      "maxCostTier": "cheap",
      "allowFallback": true
    },
    {
      "_comment": "Formatting and serialization work can prefer local or free models",
      "id": "rule-format-conversion",
      "taskType": "format-conversion",
      "preferredEndpoints": ["local-llm-ollama", "opencode-cli-default"],
      "maxCostTier": "free",
      "allowFallback": true
    },
    {
      "_comment": "Summaries can use a balanced paid model before free fallbacks",
      "id": "rule-summarization",
      "taskType": "summarization",
      "preferredEndpoints": ["anthropic-claude-sonnet", "opencode-cli-default"],
      "maxCostTier": "standard",
      "allowFallback": true
    },
    {
      "_comment": "Default catch-all rule — cheap or free endpoints first",
      "id": "rule-default",
      "taskType": "*",
      "preferredEndpoints": ["opencode-cli-default", "groq-llama-70b"],
      "maxCostTier": "cheap",
      "allowFallback": true
    }
  ],
  "defaultEndpoint": "opencode-cli-default",
  "qualityThreshold": 0.7,
  "qualityWindowSize": 50
}
